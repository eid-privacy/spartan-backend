{"noir_version":"1.0.0-beta.22+a0d12df5c15fa13db9a323ab89034dedb50d678a","hash":"7508030365990722958","abi":{"parameters":[{"name":"credential_string","type":{"kind":"string","length":218},"visibility":"private"},{"name":"signature_device","type":{"kind":"array","length":64,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"private"},{"name":"challenge_hash","type":{"kind":"array","length":32,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"public"},{"name":"R_x","type":{"kind":"array","length":32,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"public"},{"name":"R_y","type":{"kind":"array","length":32,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"public"},{"name":"T_x","type":{"kind":"array","length":32,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"public"},{"name":"T_y","type":{"kind":"array","length":32,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"public"},{"name":"U_x","type":{"kind":"array","length":32,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"public"},{"name":"U_y","type":{"kind":"array","length":32,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"public"}],"return_type":null,"error_types":{"361444214588792908":{"error_kind":"string","string":"attempt to multiply with overflow"},"14990209321349310352":{"error_kind":"string","string":"attempt to add with overflow"},"16431471497789672479":{"error_kind":"string","string":"Index out of bounds"}}},"bytecode":"","debug_symbols":"","file_map":{"17":{"source":"pub struct T256Point {\n    pub x: Field,\n    pub y: Field,\n}\n\npub struct T256Scalar {\n    pub lo: Field,\n    pub hi: Field,\n}\n\npub fn t256_ec_add(p1: T256Point, p2: T256Point) -> T256Point {\n    t256_ec_add_array_return(p1, p2, true)[0]\n}\n\npub fn t256_msm<let N: u32>(points: [T256Point; N], scalars: [T256Scalar; N]) -> T256Point {\n    t256_msm_array_return(points, scalars, true)[0]\n}\n\n#[foreign(embedded_curve_add)]\nfn t256_ec_add_array_return(\n    _p1: T256Point,\n    _p2: T256Point,\n    _predicate: bool,\n) -> [T256Point; 1] {}\n\n#[foreign(multi_scalar_mul)]\nfn t256_msm_array_return<let N: u32>(\n    _points: [T256Point; N],\n    _scalars: [T256Scalar; N],\n    _predicate: bool,\n) -> [T256Point; 1] {}","path":"std/field/t256.nr","function_locations":[{"start":189,"name":"t256_ec_add"},{"start":331,"name":"t256_msm"},{"start":530,"name":"t256_ec_add_array_return"},{"start":703,"name":"t256_msm_array_return"}]},"52":{"source":"use eid::{constants, decode_hex_32};\nuse eid::field_utils::{array_to_field, split_point};\nuse std::field::t256::{T256Point, T256Scalar, t256_msm, t256_ec_add};\n\nfn main(\n    // Private inputs\n    credential_string: str<constants::CREDENTIAL_LEN>,\n    signature_device: [u8; 64],\n    // Public input\n    challenge_hash: pub [u8; 32],\n    R_x: pub [u8; 32],\n    R_y: pub [u8; 32],\n    T_x: pub [u8; 32],\n    T_y: pub [u8; 32],\n    U_x: pub [u8; 32],\n    U_y: pub [u8; 32],\n) {\n    // Step 1: Verify device signature on the challenge hash\n    // Extract public key from credential_raw from hex encoded values in position\n    // 74 to 138 (32 bytes X, 32 bytes Y).\n    let pubkey_device_x = decode_hex_32(\n        credential_string.as_bytes(),\n        constants::CREDENTIAL_POS_DEVICE_PUB_X,\n    );\n    let pubkey_device_y = decode_hex_32(\n        credential_string.as_bytes(),\n        constants::CREDENTIAL_POS_DEVICE_PUB_Y,\n    );\n\n    // Safety: this is computation on public inputs, can be verified out-of-circuit\n    let s_scalar = unsafe {\n        let (_, s) = split_point(signature_device);\n        T256Scalar {\n            lo: s,\n            hi: 0,\n        }\n    };\n    let T_point = T256Point { x: array_to_field(T_x), y: array_to_field(T_y) };\n    let R_point = T256Point { x: array_to_field(R_x), y: array_to_field(R_y) };\n    let U_point = T256Point { x: array_to_field(U_x), y: array_to_field(U_y) };\n\n    let pubkey_x_field = array_to_field(pubkey_device_x);\n    // The core verification equation from Crescent: T^sU = Q, Crescent impl. checks only x coordinate\n    assert(pubkey_x_field == t256_ec_add(t256_msm([T_point], [s_scalar]), U_point).x);\n}\n","path":"/Users/clement.humbert/PrivacyPreservingEID/building-circuits/spartan-backend/circuits/c0100_holder_binding_crescent_style/src/main.nr","function_locations":[{"start":473,"name":"main"}]},"55":{"source":"// Size of a T256 field element decomposed into bytes\npub global T256_SCALAR_SIZE: u32 = 32;\n\npub fn array_to_field(arr: [u8; 32]) -> Field {\n    let mut field_value: Field = 0;\n    for i in 0..32 {\n        field_value = field_value * 256 + arr[i] as Field;\n    }\n    field_value\n}\n\nunconstrained pub fn split_point(point: [u8; 64]) -> (Field, Field) {\n    let mut lo_bytes: [u8; 32] = [0; 32];\n    let mut hi_bytes: [u8; 32] = [0; 32];\n\n    for i in 0..32 {\n        lo_bytes[i] = point[i];\n        hi_bytes[i] = point[i + 32];\n    }\n\n    (array_to_field(lo_bytes), array_to_field(hi_bytes))\n}","path":"/Users/clement.humbert/PrivacyPreservingEID/building-circuits/spartan-backend/circuits/eid/src/field_utils.nr","function_locations":[{"start":140,"name":"array_to_field"},{"start":351,"name":"split_point"}]},"56":{"source":"pub mod constants;\npub mod field_utils;\npub mod fast_base64;\n\npub global REVOCATION_LIST_LENGTH_WO_SIG: u32 = 8 + 8 + constants::REVOCATION_LIST_IDS / 8;\npub global REVOCATION_LIST_LENGTH: u32 = REVOCATION_LIST_LENGTH_WO_SIG + 64;\npub global REVOCATION_LIST_VALIDITY: u64 = 86400 * 7;\n\npub fn slice<let IN: u32, let OUT: u32>(input: [u8; IN], start: u32) -> [u8; OUT] {\n    let mut out = [0u8; OUT];\n    for i in 0..OUT {\n        out[i] = input[start + i];\n    }\n    out\n}\n\npub fn hex_to_u64<let LEN: u32>(hex_str: [u8; LEN], start: u32) -> u64 {\n    let mut result = 0u64;\n    for i in 0..8 {\n        let high_nibble = decode_nibble(hex_str[start + 2 * i]);\n        let low_nibble = decode_nibble(hex_str[start + 2 * i + 1]);\n        result = (result << 8) + ((high_nibble << 4) + low_nibble) as u64;\n    }\n    result\n}\n\npub fn decode_hex_32<let LEN: u32>(hex_str: [u8; LEN], start: u32) -> [u8; 32] {\n    let mut result: [u8; 32] = [0u8; 32];\n    for i in 0..32 {\n        let high_nibble = decode_nibble(hex_str[start + 2 * i]);\n        let low_nibble = decode_nibble(hex_str[start + 2 * i + 1]);\n        result[i] = high_nibble * 16 + low_nibble;\n    }\n    result\n}\n\nfn decode_nibble(hex_char: u8) -> u8 {\n    (hex_char & 0x0F) + (hex_char >> 6) * 9\n}\n","path":"/Users/clement.humbert/PrivacyPreservingEID/building-circuits/spartan-backend/circuits/eid/src/lib.nr","function_locations":[{"start":368,"name":"slice"},{"start":545,"name":"hex_to_u64"},{"start":901,"name":"decode_hex_32"},{"start":1207,"name":"decode_nibble"}]}}}