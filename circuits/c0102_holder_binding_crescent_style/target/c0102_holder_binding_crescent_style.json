{"noir_version":"1.0.0-beta.20+59f485250aeb1578d3b6496c54c8355eb833f7b0","hash":"5492430501145090151","abi":{"parameters":[{"name":"credential_string","type":{"kind":"string","length":218},"visibility":"private"},{"name":"signature_device","type":{"kind":"array","length":64,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"private"},{"name":"challenge_hash","type":{"kind":"array","length":32,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"public"},{"name":"R","type":{"kind":"array","length":64,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"public"},{"name":"T","type":{"kind":"array","length":64,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"public"},{"name":"U","type":{"kind":"array","length":64,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"public"}],"return_type":null,"error_types":{"361444214588792908":{"error_kind":"string","string":"attempt to multiply with overflow"},"14990209321349310352":{"error_kind":"string","string":"attempt to add with overflow"},"16431471497789672479":{"error_kind":"string","string":"Index out of bounds"}}},"bytecode":"","debug_symbols":"","file_map":{"14":{"source":"/// Verifier for ECDSA Secp256r1 signatures.\n// docs:start:ecdsa_secp256r1\n/// Verifies a ECDSA signature over the secp256r1 curve.\n/// - inputs:\n///     - x coordinate of public key as 32 bytes\n///     - y coordinate of public key as 32 bytes\n///     - the signature, as a 64 bytes array\n///       The signature internally will be represented as `(r, s)`,\n///       where `r` and `s` are fixed-sized big endian scalar values.\n///       As the `secp256r1` has a 256-bit modulus, we have a 64 byte signature\n///       while `r` and `s` will both be 32 bytes.\n///       We expect `s` to be normalized. This means given the curve's order,\n///       `s` should be less than or equal to `order / 2`.\n///       This is done to prevent malleability.\n///       For more context regarding malleability you can reference BIP 0062.\n///     - the hash of the message, as a vector of bytes\n/// - output: false for failure and true for success\npub fn verify_signature(\n    public_key_x: [u8; 32],\n    public_key_y: [u8; 32],\n    signature: [u8; 64],\n    message_hash: [u8; 32],\n) -> bool\n// docs:end:ecdsa_secp256r1\n{\n    _verify_signature(public_key_x, public_key_y, signature, message_hash, true)\n}\n\n#[foreign(ecdsa_secp256r1)]\nfn _verify_signature(\n    public_key_x: [u8; 32],\n    public_key_y: [u8; 32],\n    signature: [u8; 64],\n    message_hash: [u8; 32],\n    predicate: bool,\n) -> bool {}\n","path":"std/ecdsa_secp256r1.nr","function_locations":[{"start":1102,"name":"verify_signature"},{"start":1378,"name":"_verify_signature"}]},"18":{"source":"pub struct T256Point {\n    pub x: Field,\n    pub y: Field,\n}\n\npub struct T256Scalar {\n    pub lo: Field,\n    pub hi: Field,\n}\n\npub fn t256_ec_add(p1: T256Point, p2: T256Point) -> T256Point {\n    t256_ec_add_array_return(p1, p2, true)[0]\n}\n\npub fn t256_msm<let N: u32>(points: [T256Point; N], scalars: [T256Scalar; N]) -> T256Point {\n    t256_msm_array_return(points, scalars, true)[0]\n}\n\n#[foreign(embedded_curve_add)]\nfn t256_ec_add_array_return(\n    _p1: T256Point,\n    _p2: T256Point,\n    _predicate: bool,\n) -> [T256Point; 1] {}\n\n#[foreign(multi_scalar_mul)]\nfn t256_msm_array_return<let N: u32>(\n    _points: [T256Point; N],\n    _scalars: [T256Scalar; N],\n    _predicate: bool,\n) -> [T256Point; 1] {}","path":"std/field/t256.nr","function_locations":[{"start":189,"name":"t256_ec_add"},{"start":331,"name":"t256_msm"},{"start":530,"name":"t256_ec_add_array_return"},{"start":703,"name":"t256_msm_array_return"}]},"51":{"source":"use eid::{constants, decode_hex_32};\nuse eid::field_utils::{array_to_field, split_point};\nuse std::field::t256::{T256Point, T256Scalar, t256_msm, t256_ec_add};\n\nfn main(\n    // Private inputs\n    credential_string: str<constants::CREDENTIAL_LEN>,\n    signature_device: [u8; 64],\n    // Public input\n    challenge_hash: pub [u8; 32],\n    R: pub [u8; 64],\n    T: pub [u8; 64],\n    U: pub [u8; 64],\n) {\n    // Step 1: Verify device signature on the challenge hash\n    // Extract public key from credential_raw from hex encoded values in position\n    // 74 to 138 (32 bytes X, 32 bytes Y).\n    let pubkey_device_x = decode_hex_32(\n        credential_string.as_bytes(),\n        constants::CREDENTIAL_POS_DEVICE_PUB_X,\n    );\n    let pubkey_device_y = decode_hex_32(\n        credential_string.as_bytes(),\n        constants::CREDENTIAL_POS_DEVICE_PUB_Y,\n    );\n\n    // Safety: this is computation on public inputs, can be verified out-of-circuit\n    let s_scalar = unsafe {\n        let (_, s) = split_point(signature_device);\n        T256Scalar {\n            lo: s,\n            hi: 0,\n        }\n    };\n    // Safety: this is computation on public inputs, can be verified out-of-circuit\n    let T_point = unsafe {\n        let (Tx, Ty) = split_point(T);\n        T256Point { x: Tx, y: Ty }\n    };\n\n    // Safety: this is computation on public inputs, can be verified out-of-circuit\n    let U_point = unsafe {\n        let (Ux, Uy) = split_point(U);\n        T256Point { x: Ux, y: Uy }\n    };\n\n    let pubkey_x_field = array_to_field(pubkey_device_x);\n    // The core verification equation from Crescent: T^sU = Q, Crescent impl. checks only x coordinate\n    assert(pubkey_x_field == t256_ec_add(t256_msm([T_point], [s_scalar]), U_point).x);\n\n    let signature_device_valid = std::ecdsa_secp256r1::verify_signature(\n        pubkey_device_x,\n        pubkey_device_y,\n        signature_device,\n        challenge_hash,\n    );\n    assert(signature_device_valid);\n}","path":"/Users/clement.humbert/PrivacyPreservingEID/building-circuits/spartan-backend-progress-track/circuits/c0102_holder_binding_crescent_style/src/main.nr","function_locations":[{"start":398,"name":"main"}]},"53":{"source":"// Size of a T256 field element decomposed into bytes\npub global T256_SCALAR_SIZE: u32 = 32;\n\npub fn array_to_field(arr: [u8; 32]) -> Field {\n    let mut field_value: Field = 0;\n    for i in 0..32 {\n        field_value = field_value * 256 + arr[i] as Field;\n    }\n    field_value\n}\n\nunconstrained pub fn split_point(point: [u8; 64]) -> (Field, Field) {\n    let mut lo_bytes: [u8; 32] = [0; 32];\n    let mut hi_bytes: [u8; 32] = [0; 32];\n\n    for i in 0..32 {\n        lo_bytes[i] = point[i];\n        hi_bytes[i] = point[i + 32];\n    }\n\n    (array_to_field(lo_bytes), array_to_field(hi_bytes))\n}","path":"/Users/clement.humbert/PrivacyPreservingEID/building-circuits/spartan-backend-progress-track/circuits/eid/src/field_utils.nr","function_locations":[{"start":140,"name":"array_to_field"},{"start":351,"name":"split_point"}]},"54":{"source":"pub mod constants;\npub mod field_utils;\n\npub global REVOCATION_LIST_LENGTH_WO_SIG: u32 = 8 + 8 + constants::REVOCATION_LIST_IDS / 8;\npub global REVOCATION_LIST_LENGTH: u32 = REVOCATION_LIST_LENGTH_WO_SIG + 64;\npub global REVOCATION_LIST_VALIDITY: u64 = 86400 * 7;\n\npub fn slice<let IN: u32, let OUT: u32>(input: [u8; IN], start: u32) -> [u8; OUT] {\n    let mut out = [0u8; OUT];\n    for i in 0..OUT {\n        out[i] = input[start + i];\n    }\n    out\n}\n\npub fn hex_to_u64<let LEN: u32>(hex_str: [u8; LEN], start: u32) -> u64 {\n    let mut result = 0u64;\n    for i in 0..8 {\n        let high_nibble = decode_nibble(hex_str[start + 2 * i]);\n        let low_nibble = decode_nibble(hex_str[start + 2 * i + 1]);\n        result = (result << 8) + ((high_nibble << 4) + low_nibble) as u64;\n    }\n    result\n}\n\npub fn decode_hex_32<let LEN: u32>(hex_str: [u8; LEN], start: u32) -> [u8; 32] {\n    let mut result: [u8; 32] = [0u8; 32];\n    for i in 0..32 {\n        let high_nibble = decode_nibble(hex_str[start + 2 * i]);\n        let low_nibble = decode_nibble(hex_str[start + 2 * i + 1]);\n        result[i] = high_nibble * 16 + low_nibble;\n    }\n    result\n}\n\nfn decode_nibble(hex_char: u8) -> u8 {\n    (hex_char & 0x0F) + (hex_char >> 6) * 9\n}\n","path":"/Users/clement.humbert/PrivacyPreservingEID/building-circuits/spartan-backend-progress-track/circuits/eid/src/lib.nr","function_locations":[{"start":347,"name":"slice"},{"start":524,"name":"hex_to_u64"},{"start":880,"name":"decode_hex_32"},{"start":1186,"name":"decode_nibble"}]}}}