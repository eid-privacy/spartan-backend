{
  "packages": [
    "rustup@latest",
    "libiconv@latest",
    "time@latest",
    "github:eid-privacy/flakes#noir-versions.v1_0_0-beta_18",
    "github:eid-privacy/flakes#barretenberg-versions.beta_18",
    "github:eid-privacy/flakes#nargo-t256-versions.t256-v0_1"
  ],
  "env": {
    "PROJECT_DIR": "$PWD"
  },
  "shell": {
    "init_hook": [
      "rustup default stable"
    ],
    "scripts": {
      "fetch": "( cd spartan-backend && cargo fetch )",
      "ls": "ls && pwd",
      "build": "cd spartan-backend && cargo build --release",
      "start": "cd spartan-backend && cargo run",
      "test": "cd spartan-backend && cargo test -- --show-output",
      "fmt-check": "cd spartan-backend && cargo fmt --check",
      "nargo-check": "for dir in circuits/c0*/; do (cd \"$dir\" && nargo-t256 execute); done && git diff --exit-code",
      "build-docs": "cd spartan-backend && cargo doc",
      "benchmark": "./scripts/benchmark.sh"
    }
  }
}
