{
  "packages": [
    "rustup@latest",
    "libiconv@latest",
    "time@latest",
    "jq@latest",
    "samply@latest",
    "python@3.14",
    "python314Packages.matplotlib",
    "python314Packages.numpy@latest",
    "github:eid-privacy/flakes#noir-versions.v1_0_0-beta_23",
    "github:eid-privacy/flakes#barretenberg-versions.beta_23",
    "github:eid-privacy/flakes#nargo-t256-versions.t256-v0_23"
  ],
  "env": {
    "PROJECT_DIR": "$PWD"
  },
  "nixConfig": {
    "extra-substituters": "https://eid-privacy.cachix.org",
    "extra-trusted-public-keys": "eid-privacy.cachix.org-1:lxRzvjcWd/A6Wew1tq0IK6OIMVWNJKUTy4s7EKb6C2A="
  },
  "shell": {
    "init_hook": [
      "rustup default stable",
      ". $VENV_DIR/bin/activate",
      "rustup toolchain install nightly --component rustfmt"
    ],
    "scripts": {
      "fetch": "( cd spartan-backend && cargo fetch )",
      "ls": "ls && pwd",
      "build": "cd spartan-backend && cargo build --release",
      "build-check": "cd spartan-backend && RUSTFLAGS=\"-D warnings\" cargo build --all-targets",
      "start": "cd spartan-backend && RUST_LOG=info cargo run",
      "test": "cd spartan-backend && cargo test -- --show-output",
      "fmt-check": "cd spartan-backend && cargo +nightly fmt --check",
      "fmt": "cd spartan-backend && cargo +nightly fmt",
      "nargo-check": "./scripts/nargo_check.sh",
      "build-docs": "cd spartan-backend && cargo doc",
      "stats-table": "python3 scripts/stats_table.py --update-readme README.md",
      "benchmark": "./scripts/benchmark.sh",
      "benchmark-commits": "./scripts/benchmark_commits.sh $@",
      "samply": "./scripts/samply.sh $@",
      "plot": "python3 ./scripts/plot_benchmarks.py $@",
      "plot-commits": "python3 ./scripts/plot_benchmark_commits.py $@"
    }
  }
}
